{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix packages/ui --no-audit --no-fund && npm ci --prefix apps/web --no-audit --no-fund",
  "buildCommand": "npm --prefix apps/web run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{apps/api/app/**,packages/core_py/core_py/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
